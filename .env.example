# Salem Star Speaker — public website build configuration.
#
# Everything here is compiled into a PUBLIC JavaScript bundle that anyone can
# read. Never put a Razorpay secret, SMTP password or database URL in this
# file — those belong in sss-api's server-side .env and nowhere else.
# (The Razorpay KEY ID is public by design and comes from the API at runtime,
# not from here.)

# Absolute URL of the API, including the /api/v1 prefix.
#
# REQUIRED in production. The website and the API are on different subdomains,
# so the default relative path ("/api/v1") would resolve against the website's
# own host, hit the SPA fallback, and return the HTML page instead of JSON —
# which surfaces as "Server returned non-JSON response" when someone registers.
#
# Leave this UNSET for local development: `npm run dev` proxies /api to
# http://localhost:4000 via vite.config.js.
VITE_API_BASE_URL=https://sssapi.eventsinfinite.com/api/v1
